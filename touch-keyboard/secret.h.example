#ifndef TOUCH_KEYBOARD_SECRET_H
#define TOUCH_KEYBOARD_SECRET_H

/* Template for the keystroke payload typed on touch.
 *
 * Copy this file to secret.h (which is gitignored) and set your own text:
 *     cp secret.h.example secret.h
 *
 * Trailing \r presses Enter after the text. */
#define SECRET_TEXT "type me!\r"

#endif // TOUCH_KEYBOARD_SECRET_H
